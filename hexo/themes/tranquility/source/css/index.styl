@import '_variables';

$anchor-border = $gainsboro;
/* get timeline color config from __config.yml */
timeline_colors = {};

for item in hexo-config('timeline.items') {
  for key in item {
    if (key[0] == 'name') {
      c_name = key[1];
    }

    if (key[0] == 'color') {
      c_value = key[1];
    }
  }

  timeline_colors[c_name] = c_value;
}

.wall.wall-index {
  max-width: none;
  width: 100%;
  overflow: visible;
  background: $white-blue-lightest;
  user-select: text;
  -webkit-user-select: text;
}

.wall-index ::selection {
  background: $gainsboro;
  color: $black-deep;
}

.wall-sheet {
  width: 100%;
  max-width: 38em;
  margin: 0 auto;
  padding: 40px 20px;
  text-align: center;
}

.wall-sheet p {
  margin: 0;
  text-align: center;
}

.wall-title {
  margin: 0;
  font-family: sourceHanSerif, serif;
  font-weight: 600;
  font-size: 72px;
  line-height: 1.15;
  letter-spacing: 0.2em;
  color: $black-deep;
  text-wrap: balance;
}

.wall-sheet .wall-subtitle {
  margin-top: 10px;
  font-family: sourceHanSerif, serif;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.04em;
  color: $black-deep;
}

.wall-sheet .wall-description {
  margin-top: 10px;
  font-family: sourceHanSerif, serif;
  font-size: 20px;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0.2em;
  color: $black-deep;
}

.wall-sign {
  margin: 28px 0 0;
  font-size: 0;
  line-height: 0;
  text-align: center;
}

.wall-sign img {
  display: block;
  width: 280px;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
  background: transparent;
}

.about {
  max-width: 900px;
  margin: 200px auto;
  display: flex;
  justify-content: space-between;
}

.about-photo {
  width: 300px;
  height: 450px;
  background: url('') center center / cover no-repeat;
  margin: 0 10px;
  transition: all 200ms ease-out;

  &:hover {
    box-shadow: 0 0 14px 0 $anchor-border;
    transform: translateY(-4px);
  }
}

.about-text {
  font-weight: bold;
  font-family: sourceHanSerif;
}

.about-title {
  text-align: center;
  font-size: 40px;
  font-weight: bold;
  margin: 40px 0;
}

.about-detail {
  font-size: 20px;
  line-height: 2em;
  letter-spacing: 0.3em;
  margin: 0 10px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.about-text-p {
  padding: 20px 10px;
}

.timeline {
  max-width: 1100px;
  margin: 300px auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-head {
  display: flex;
  justify-content: center;
  align-items: center;
}

.timeline-head .title {
  font-size: 40px;
  font-weight: bold;
}

.radio-wrapper {
  display: flex;
  align-items: flex-end;
  margin: 0 10px;
}

.radio {
  position: relative;
  width: 20px;
  margin: 0 10px;
  height: 40px;
}

.radio>label {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio>input {
  position: absolute;
  opacity: 0;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio-skin {
  height: 100%;
  width: 2px;
  border-radius: 1px;
  background: #ccc;
  transition: all 0.4s ease;

  &::after {
    transition: all 0.4s ease;
    display: block;
    height: 20px;
    width: 20px;
    border-radius: 50%;
    background-color: #fafafa;
    border: 2px solid transparent;
    box-sizing: border-box;
    content: '';
    position: absolute;
    left: -9px;
    top: 22px;
    box-shadow: 1px 0 5px rgba(0, 0, 0, 0.2);
  }
}

for v, k in timeline_colors {
  .radio-skin--{v} {
    @extend .radio-skin;

    &::after {
      border-color: convert(k);
    }
  }

  #radio-{v}:checked+.radio-skin--{v} {
    background-color: convert(k);

    &::after {
      background-color: convert(k);
      top: -2px;
    }
  }

  .timeline-item-{v}, .timeline-item-{v}--hidden {
    .line-anchor::after {
      background-color: convert(k);
    }

    .line-date-tag {
      background-color: convert(k);
    }
  }

  /*
  .timeline-item-app, .timeline-item-event {
    font-weight: bold;
  }
  */
}

.timeline-body {
  width: 100%;
}

.line-anchor::after {
  content: '';
  position: absolute;
  height: 16px;
  width: 16px;
  border-radius: 50%;
  right: -9px;
  bottom: 0;
  left: -9px;
  top: 0;
  margin: auto;
  border: 2px solid $anchor-border;
}

.line-anchor {
  position: relative;
  height: 20px;
  margin: 10px 4px;
  flex: 0 0 20px;
}

.line-date, .line-title {
  flex: 1;
  display: flex;
  align-items: center;
}

.line-date {
  justify-content: flex-end;
}

.line-title .text-icon {
  margin: 0 8px;
}

.timeline-list {
  position: relative;
}

.timeline-list::before {
  position: absolute;
  content: '';
  top: -20px;
  left: 0;
  right: 0;
  bottom: -20px;
  margin: 0 auto;
  width: 2px;
  background-color: $anchor-border;
  z-index: -1;
}

.timeline-post {
  text-decoration: none;
}

.timeline-item {
  width: 100%;
  display: flex;
  padding: 20px 0;
  justify-content: flex-start;
  align-items: center;
  font-size: 18px;
  overflow: hidden;
  transition: all 200ms ease-out;
  transition-delay: 200ms;
  height: 80px;

  &-first, &-last {
    @extend .timeline-item;
    height: auto;
    padding: 0;
    justify-content: center;
  }

  &:nth-child(even) {
    flex-direction: row-reverse;

    .line-title {
      justify-content: flex-end;
    }

    .line-date {
      justify-content: flex-start;
    }
  }
}

.timeline-item--hidden {
  @extend .timeline-item;
  height: 0;
  padding: 0;
  transform: rotateX(90deg);
  opacity: 0;
}

.line-anchor--now, .line-anchor--end {
  height: 40px;
  background: none;
}

.icon-anchor {
  position: absolute;
  left: -20px;
  right: -20px;
  height: 41px;
  width: 41px;
  top: 23px;
}

.line-anchor--end::after {
  background-color: $anchor-border;
}

.line-anchor--now::after {
  border: 2px solid $anchor-border;
}

.line-date-tag {
  display: inline-block;
  font-size: 14px;
  color: #fff;
  padding: 0 4px;
  border-radius: 3px;
}

@media screen and (max-width: 1023px) {
  .wall {
    height: calc(100vh - 60px);
  }

  .hello-world {
    left: 20px;
  }

  .about {
    margin: 100px auto;
    flex-direction: column-reverse;
    justify-content: center;
    align-items: center;
  }

  .about-text {
    margin-bottom: 50px;
  }

  .about-detail {
    text-align: center;
  }

  .wall-title {
    font-size: 48px;
  }

  .wall-subtitle {
    font-size: 28px;
  }
}

@media screen and (max-width: 415px) {
  .timeline {
    margin: 200px auto;
  }

  .timeline-list {
    .timeline-item {
      flex-direction: column;
      height: auto;
    }

    .line-date {
      border-radius: 4px;
      border: 2px solid $whitesmoke;
    }

    .line-title {
      background: white;
      border-radius: 4px;
      border: 2px solid $whitesmoke;
      padding: 4px;
    }
  }

  .about-detail {
    font-size: $font-size-base;
  }

  .wall-title {
    font-size: 36px;
  }

  .wall-subtitle {
    font-size: 24px;
  }
}