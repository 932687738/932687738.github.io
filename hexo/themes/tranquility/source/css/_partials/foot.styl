
.foot {
  background-color: #000;
}

.foot-inner {
  color: #aaa;
  margin: 0 auto;
  max-width: 1200px;
  padding: 48px 20px 28px;
  text-align: center;
}

.foot-verse {
  margin: 0;
  font-family: sourceHanSerif, serif;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.12em;
  color: #aaa;
}

.foot-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8px 28px;
  margin-top: 28px;
}

.foot-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #aaa;
  font-size: 16px;
  letter-spacing: 0.04em;
  text-decoration: none;
}

.foot a:hover {
  color: #fff;
}

.foot a:focus-visible {
  outline: 1px solid #ddd;
  outline-offset: 4px;
}

.copyright {
  margin-top: 28px;
  font-size: $font-size-smaller;
  letter-spacing: 0.12em;
  color: #aaa;
}

.copyright a {
  color: inherit;
  text-decoration: none;
}

@media screen and (max-width: 415px) {
  .foot-verse {
    font-size: 28px;
  }
}
