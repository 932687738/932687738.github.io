@import '_hljs-github';
@import '_variables';

.body {
  line-height: 2em;
  padding-left: 50px;
  padding-right: 50px;
}

.post-inner {
  margin: 0 auto;
  max-width: 900px;

  &--toc {
    @extend .post-inner;
    max-width: 760px;
    padding-right: 230px;

    .post-content__body {
      max-width: 760px;
    }
  }

  .video-container {
    height: 0;
    margin-bottom: 20px;
    overflow: hidden;
    padding-top: 75%;
    position: relative;
    width: 100%;

    iframe {
      height: 100%;
      left: 0;
      margin: 0;
      position: absolute;
      top: 0;
      width: 100%;
    }
  }
}

.post-content {
  padding: 10px 0;
  margin: 0 auto;
}

.post-gallery {
  align-items: center;
  display: grid;
  grid-gap: 10px;
  grid-template-columns: 1fr 1fr 1fr;
  margin-bottom: 20px;
}

.post-title {
  font-size: 30px;
}

.post-content__head {
  margin: 40px 0;
}

.toc-outer {
  opacity: 0.9;
  position: sticky;
  top: 60px;
  float: right;
  margin-right: -230px;
  max-height: calc(100vh - 250px);
  min-height: 400px;
  padding-left: 30px;
  overflow-y: auto;
  width: 200px;
  color: $black-lighter;

  .toc-title, .toc-top {
    display: inline-block;
    padding: 8px 0;
    color: $text-color;
    font-size: $font-size-small;
    height: 30px;
    line-height: 30px;
  }

  .toc-title {
    border-top: 2px solid $white-blue;
  }

  a {
    text-decoration: none;
  }

  ol, li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-number {
    font-size: 80%;
  }

  .post-toc {
    width: 100%;
    text-align: left;
    margin: 0;
    padding: 0;
    display: inline-block;
    text-align: left;
    box-sizing: border-box;
    line-height: 1.25em;

    &-level {
      &-2 {
        font-size: 15px;
        margin: 5px 0;
      }

      &-3 {
        font-size: 14px;
        padding-left: 10px;
      }
    }
  }
}

.post__foot {
  max-width: 900px;
  margin: 100px auto;
}

.post-nav {
  position: relative;
  margin-top: 60px;
  display: flex;
  width: 100%;
  justify-content: space-between;

  .vhr {
    position: absolute;
    height: 50px;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    margin: auto;
    background-color: $whitesmoke;
    width: 1px;
  }
}

.post-nav-item {
  text-decoration: none;
  flex: 1;
  display: flex;
  flex-direction: column;

  &-left {
    @extend .post-nav-item;
    align-items: flex-start;
    padding-right: 15px;
  }

  &-right {
    @extend .post-nav-item;
    align-items: flex-end;
    padding-left: 15px;
  }
}

.related-post {
  margin: 40px 0;
}

.post-content ::selection {
  background: $gainsboro;
  color: $black-deep;
}

.post-content .post-title {
  font-family: sourceHanSerif, serif;
  font-size: 40px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.02em;
  color: $black-deep;
  text-wrap: balance;
}

.post-content .post-info {
  color: $black-light;
  font-size: 14px;
  letter-spacing: 0.04em;
}

.post-content__body {
  overflow-x: auto;
  scrollbar-color: $grey-light transparent;

  p {
    text-align: start;
    max-width: 38em;
    line-height: 1.8;
    color: $black-dim;
  }

  p a {
    color: $black-deep;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    text-decoration-color: $grey-light;
  }

  p a:hover {
    text-decoration-color: $black-deep;
  }

  h2 {
    max-width: 38em;
    margin: 48px 0 16px;
    font-family: sourceHanSerif, serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.04em;
    color: $black-deep;
    text-wrap: balance;
  }

  h3 {
    max-width: 38em;
    margin: 36px 0 12px;
    font-family: sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    color: $black-deep;
  }

  ul,
  ol {
    max-width: 38em;
    margin: 0 0 16px;
    padding-left: 1.4em;
    color: $black-dim;
    line-height: 1.7;
  }

  li {
    margin: 8px 0;
  }

  li > ul,
  li > ol {
    margin: 6px 0 0;
  }

  strong {
    color: $black-deep;
    font-weight: 700;
  }

  hr {
    border: 0;
    border-top: 1px solid $gainsboro;
    margin: 28px 0;
    max-width: 38em;
  }

  img {
    margin: 16px 0 28px;
    box-shadow: 0 12px 32px rgba(34, 34, 34, 0.07);
  }

  table {
    width: 100%;
    min-width: 40rem;
    margin: 28px 0 40px;
    border-collapse: collapse;
    background: $white-blue-lightest;
    box-shadow: 0 12px 32px rgba(34, 34, 34, 0.07);
    font-size: 15px;
    line-height: 1.55;
    font-variant-numeric: tabular-nums;
    text-align: left;
  }

  tbody tr:nth-of-type(odd) {
    background: transparent;
  }

  caption,
  th,
  td {
    border: 0;
    border-bottom: 1px solid $gainsboro;
    padding: 16px 18px;
    vertical-align: top;
    background: transparent;
  }

  th {
    padding-top: 18px;
    padding-bottom: 12px;
    border-bottom-color: $black-dim;
    color: $black-dim;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  th[align="right"],
  td[align="right"] {
    text-align: right;
    white-space: nowrap;
  }

  td[align="right"] {
    color: $black-deep;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  td:first-child {
    width: 3em;
    color: $black-light;
    white-space: nowrap;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody tr:hover td {
    background: #fff;
  }

  td a {
    color: $black-deep;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    text-decoration-color: $grey;
  }

  td a:hover {
    color: $black;
    text-decoration-color: $black;
  }

  td code,
  td a code {
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: Consolas, Menlo, monospace;
    font-size: 0.92em;
    font-weight: 400;
    letter-spacing: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  td small {
    display: block;
    margin-top: 6px;
    color: $black-light;
    font-family: sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.45;
  }

  a:focus-visible {
    outline: 1px solid $black-dim;
    outline-offset: 3px;
  }
}

.post-content--rank .post-content__body {
  > p:not(:last-of-type) {
    max-width: none;
    margin: 0;
    background: $white-blue-lightest;
    box-shadow: 0 12px 32px rgba(34, 34, 34, 0.07);
    clip-path: inset(-48px -48px 0 -48px);
  }

  > p:first-of-type {
    margin-top: 28px;
    padding: 20px 18px 6px;
    font-size: 15px;
    line-height: 1.65;
    color: $black-dim;
  }

  > p:nth-of-type(2) {
    padding: 0 18px 14px;
    font-size: 13px;
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: $black-light;
  }

  > p:nth-of-type(2) a {
    color: $black-light;
    font-weight: 400;
    text-decoration-color: $grey;
    overflow-wrap: anywhere;
  }

  > table {
    margin-top: 0;
    margin-bottom: 0;
    clip-path: inset(0 -48px -48px -48px);
  }

  > p:last-of-type {
    margin-top: 28px;
    padding: 0;
    background: transparent;
    box-shadow: none;
    clip-path: none;
    max-width: 38em;
    font-size: 15px;
    line-height: 1.7;
    color: $black-dim;
  }
}

@media screen and (max-width: 760px) {
  .post-content .post-title {
    font-size: 32px;
  }

  .post-content__body {
    th,
    td {
      padding: 12px 10px;
    }
  }

  .post-inner--toc {
    padding: 0;

    .post-content__body {
      max-width: 100%;
    }
  }

  .toc-outer {
    display: none;
  }
}

@media screen and (max-width: 1023px) {
  .body {
    padding-left: 30px;
    padding-right: 30px;
  }

  .post-gallery {
    grid-template-columns: 1fr 1fr;
  }
}
