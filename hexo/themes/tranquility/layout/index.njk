{% extends "_partials/layout.njk" %}
{% block link %}
  {% if theme.baidu_site_verification %}
    <meta name="baidu-site-verification"
          content="{{ theme.baidu_site_verification }}"/>
  {% endif %}
  <link rel="stylesheet"
        type="text/css"
        href='{{ url_for("/css/index.css") }}'/>
{% endblock link %}
{% block body %}
  <div class="wall wall-index">
    <div class="wall-sheet">
      <p class="wall-subtitle">{{ config.subtitle }}</p>
      <h1 class="wall-sign">
        <img src="{{ url_for('/images/guke.png') }}" alt="古柯">
      </h1>
    </div>
  </div>
{% endblock body %}